<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!-- From here, the following are versioned via `spring-boot-dependencies`: Spring Framework,
     Hibernate, Jackson, the PostgreSQL driver, JUnit, Mockito, AssertJ,
     Testcontainers, and surefire/failsafe. We do not specify versions anywhere else. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>user-service</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>user-service</name>
  <description>REST service for user management: Spring Boot + Data JPA + PostgreSQL</description>

  <modules>
    <module>service</module>
    <module>notification-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>
  </properties>
  <profiles>
    <profile>
      <id>local-jdk26</id>
      <activation>
        <jdk>[26,)</jdk>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <forkCount>0</forkCount>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <forkCount>0</forkCount>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>